{
  "scenarios": [
    {
      "id": "austin-hope",
      "note": "Status quo exists; person would stay if it gave them what they want. Pivot is the hope.",
      "session": {
        "title": "move to Austin",
        "options": [
          "Move to Austin",
          "Stay here"
        ],
        "criteria": [
          [
            "growth",
            "Career growth",
            5
          ],
          [
            "security",
            "Financial security",
            4
          ],
          [
            "friends",
            "Friends",
            3
          ],
          [
            "adventure",
            "Adventure",
            2
          ]
        ],
        "evals": {
          "growth": {
            "pref": 2,
            "conf": 1
          },
          "security": {
            "pref": -1,
            "conf": 4
          },
          "friends": {
            "pref": -2,
            "conf": 5
          },
          "adventure": {
            "pref": 1,
            "conf": 3
          }
        },
        "notes": {
          "hope": "to feel like my life is actually moving",
          "stillWant": "no"
        }
      },
      "expect": {
        "pivot_kind": "hope",
        "pivot_contains": "Can where you live now actually let you feel like your life is actually moving?",
        "next_criterion": "Career growth",
        "reframe": true
      }
    },
    {
      "id": "austin-growth",
