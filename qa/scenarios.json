    {
      "id": "hope-ruled-out",
      "note": "Hope ruled out at the confirmation step; the criterion Pivot takes over.",
      "session": {
        "title": "move to Austin",
        "options": [
          "Move to Austin",
          "Stay here"
        ],
        "criteria": [
          [
            "growth",
            "Career growth",
            5
          ],
          [
            "security",
            "Financial security",
            4
          ]
        ],
        "evals": {
          "growth": {
            "pref": 2,
            "conf": 1
          },
          "security": {
            "pref": -2,
            "conf": 5
          }
        },
        "notes": {
          "hope": "a bigger life",
          "stillWant": "no"
        },
        "ruledOut": {
          "hope": true
        }
      },
      "expect": {
        "pivot_kind": "criterion",
        "pivot_criterion": "Career growth"
      }
    }
  ],
  "mutations": [
    {
      "id": "confidence-to-known-moves-pivot",
      "base": "austin-growth",
      "set": {
        "evals.growth.conf": 5
      },
      "expect": "pivot_changes",
      "note": "Once growth is known it can't be the Pivot."
    },
    {
      "id": "importance-drop-moves-pivot",
      "base": "austin-growth",
      "set": {
        "criteria.growth.importance": 1
      },
      "expect": "pivot_changes",
      "note": "If growth barely matters, it can't be the hinge."
    },
    {
      "id": "reversing-the-top-preference-changes-leader",
      "base": "austin-growth",
      "set": {
        "evals.growth.pref": -2
      },
      "expect": "leader_changes",
      "note": "Reversing the heaviest preference reorders the options."
    },
    {
      "id": "ruling-out-criterion-moves-pivot",
      "base": "austin-growth",
      "set": {
        "ruledOut.growth": true
      },
      "expect": "pivot_changes",
      "note": "The person says knowing growth wouldn't change their mind; the next uncertainty takes over."
    },
    {
      "id": "stillwant-no-promotes-hope",
      "base": "austin-growth",
      "set": {
        "notes.hope": "a bigger life",
        "notes.stillWant": "no"
      },
      "expect": "pivot_kind:hope",
      "note": "The still-want test outranks a criterion."
    },
    {
      "id": "irrelevant-change-keeps-pivot",
      "base": "austin-growth",
      "set": {
        "evals.adventure.pref": -1
      },
      "expect": "pivot_same",
      "note": "A low-weight, moderately sure criterion moving a notch shouldn't move the Pivot."
    }
  ]
}