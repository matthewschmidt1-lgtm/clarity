{
  "scenarios": [
    {
      "id": "job-growth-hope",
      "note": "The walkthrough. Person would stay if their current job gave them what they want, so the Pivot is the hope, not the factor.",
      "session": {
        "question": "Should I take the new job?",
        "hope": "less stress and a manager who respects me",
        "stillWant": "no",
        "hard": "Leaving people I like for a company I don't know.",
        "factors": [
          {
            "id": "growth",
            "label": "Career growth",
            "winner": "a",
            "basis": "assume",
            "flips": true
          },
          {
            "id": "environment",
            "label": "Day-to-day environment",
            "winner": "unknown",
            "basis": null,
            "flips": false
          },
          {
            "id": "security",
            "label": "Financial security",
            "winner": "b",
            "basis": "know",
            "flips": null
          }
        ],
        "lean": "a",
        "findOut": "soon",
        "reversibility": "easy"
      },
      "expect": {
        "options": [
          "Take the new job",
          "Stay where I am"
        ],
        "known": 1,
        "assumed": 1,
        "unknown": 1,
        "pivot_kind": "hope",
        "secondary_factor": "Career growth",
        "reframe": true,
        "pivot_contains": "Can your current job actually give you less stress and a manager who respects you?",
        "discovery_contains": "Maybe the question isn't whether to take the new job."
      }
    },
