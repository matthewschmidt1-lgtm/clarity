  "mutations": [
    {
      "id": "flip-answer-changes-pivot",
      "base": "job-growth-plain",
      "set": {
        "factors.0.flips": false
      },
      "expect": "pivot_changes",
      "note": "If growth would no longer flip the lean, the Pivot must change (here: to robust)."
    },
    {
      "id": "stillwant-no-promotes-hope",
      "base": "job-growth-plain",
      "set": {
        "stillWant": "no"
      },
      "expect": "pivot_changes",
      "note": "Saying they'd stay if they got what they want must move the Pivot to the hope."
    },
    {
      "id": "known-fact-reversal-keeps-pivot",
      "base": "job-growth-plain",
      "set": {
        "factors.2.winner": "a"
      },
      "expect": "pivot_same",
      "note": "Reversing a known fact that doesn't flip the lean should not move the Pivot."
    },
    {
      "id": "assumption-becomes-known",
      "base": "job-growth-plain",
      "set": {
        "factors.0.basis": "know"
      },
      "expect": "pivot_changes",
      "note": "Once growth is known, it is no longer uncertain, so it cannot be the Pivot."
    },
    {
      "id": "removing-only-uncertainty-yields-none",
      "base": "lean-b-assumed",
      "set": {
        "factors.0.basis": "know"
      },
      "expect": "pivot_kind:none",
      "note": "With nothing uncertain left, no Pivot is produced."
    },
    {
      "id": "torn-known-first-moves-pivot",
      "base": "torn-first-unknown",
      "set": {
        "factors.0.basis": "know"
      },
      "expect": "pivot_factor:Career growth",
      "note": "When torn, if the first-ranked factor becomes known, the Pivot moves to the next uncertainty."
    },
    {
      "id": "ruling-out-hope-moves-pivot",
      "base": "job-growth-hope",
      "set": {
        "hopeRuledOut": true
      },
      "expect": "pivot_factor:Career growth",
      "note": "Once the person says the current option can't give them what they want, the factor Pivot takes over."
    }
  ]
}